# Copy to /etc/mill-backend.env on the EC2 server (chmod 600), fill in, and NEVER commit the real file.
SPRING_PROFILES_ACTIVE=prod

# RDS
DB_HOST=your-db.xxxxxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=mill_db
DB_USERNAME=admin
DB_PASSWORD=change-me

# Security (generate with: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=https://your-frontend-domain
SUPER_ADMIN_PASSWORD=change-me
DEV_ADMIN_PASSWORD=change-me

# Optional
# SERVER_PORT=3001
# DB_POOL_SIZE=5
# JPA_DDL_AUTO=update
# API_DOCS_ENABLED=false
# LOG_LEVEL=INFO
# SMS_PROVIDER=log

# JVM: keep the heap small on a t4g.micro (1 GB); India time for server-side "today".
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -XX:+UseSerialGC -Duser.timezone=Asia/Kolkata
